[mysqld]
# Pelne utf8mb4 - polskie znaki i emoji w notatkach do klientow musza dzialac
# bez niespodzianek.
#
# Kolacja `utf8mb4_unicode_ci`, a NIE `utf8mb4_0900_ai_ci`: ta druga istnieje
# wylacznie w MySQL 8. Serwer produkcyjny (hosting wspoldzielony) stoi na
# MariaDB, ktora jej nie zna - migracje wywracaly sie tam na bledzie 1273
# "Unknown collation". Dev musi uzywac tej samej kolacji co produkcja, bo
# kolacja decyduje o porownywaniu tekstu, a wiec i o tym, czy UNIQUE na
# e-mailu zlapie duplikat rozniacy sie wielkoscia liter.
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# Bez ONLY_FULL_GROUP_BY raporty potrafia po cichu zwracac przypadkowe wiersze,
# a bez STRICT_TRANS_TABLES MySQL obcina za dlugie wartosci zamiast zglosic blad.
sql_mode = STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION,ONLY_FULL_GROUP_BY

default_storage_engine = InnoDB
innodb_file_per_table = 1
# Do developmentu wystarczy; na produkcji ustaw ok. 60-70% pamieci serwera.
innodb_buffer_pool_size = 512M
innodb_flush_log_at_trx_commit = 2

max_connections = 200
default_time_zone = '+00:00'

[client]
default-character-set = utf8mb4
