# Konfiguracja srodowiska lokalnego.
# Skopiuj ten plik do .env i dostosuj. Na produkcji ustaw zmienne w konfiguracji serwera/kontenera.

APP_ENV=dev
APP_DEBUG=true

# --- Baza danych (MySQL 8) ---
DB_HOST=mysql
DB_PORT=3306
DB_NAME=solidus
DB_USER=solidus
DB_PASSWORD=solidus

# --- JWT ---
# Wygeneruj losowy sekret, np.: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=zmien-mnie-na-losowy-sekret-min-32-znaki
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
JWT_ISSUER=solidus

# --- Frontend (CORS) ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Poczta wychodzaca (Symfony Mailer DSN) ---
# Dev: Mailhog (nic nie wychodzi na zewnatrz, podglad na http://localhost:8025).
# Produkcja: prawdziwy serwer SMTP, np. smtp://user:pass@smtp.host:587
MAILER_DSN=smtp://mailhog:1025
MAILER_FROM=no-reply@solidus.local
MAILER_FROM_NAME=Solidus

# --- Baza testowa (PHPUnit) ---
# Celowo osobne zmienne: testy kasuja i tworza tabele od nowa.
TEST_DB_HOST=mysql
TEST_DB_PORT=3306
TEST_DB_NAME=solidus_test
TEST_DB_USER=solidus
TEST_DB_PASSWORD=solidus

# --- Redis / kolejka zadan ---
# WYLACZONE. Srodowisko docelowe nie ma Redisa.
# Po jego udostepnieniu: patrz docs/ARCHITECTURE.md, sekcja "Kolejka".
# REDIS_HOST=redis
# REDIS_PORT=6379
