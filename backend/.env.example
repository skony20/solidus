# Konfiguracja srodowiska lokalnego.
# Skopiuj ten plik do .env i dostosuj. Na produkcji ustaw zmienne w konfiguracji serwera/kontenera.

APP_ENV=dev
APP_DEBUG=true

# --- Baza danych (MySQL 8) ---
DB_HOST=mysql
DB_PORT=3306
DB_NAME=solidus
DB_USER=solidus
DB_PASSWORD=solidus

# --- Redis (kolejki) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- JWT ---
# Wygeneruj losowy sekret, np.: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=zmien-mnie-na-losowy-sekret-min-32-znaki
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
JWT_ISSUER=solidus

# --- Frontend (CORS) ---
FRONTEND_ORIGIN=http://localhost:5173
